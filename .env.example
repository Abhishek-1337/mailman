# OpenAI (extraction: company/role/status — still required)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Jev pre-filter (TypeSafe System One classification). Optional:
# leave TYPESAFE_API_KEY blank to keep the old LLM-only behavior.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# TYPESAFE_ENDPOINT=https://api.typesafe.ai/v1/systemone
JEV_THRESHOLD=0.7

# Google
GMAIL_CREDENTIALS_PATH=./credentials/gmail_credentials.json
GMAIL_TOKEN_PATH=./credentials/gmail_token.json
SHEETS_CREDENTIALS_PATH=./credentials/sheets_credentials.json
SHEETS_TOKEN_PATH=./credentials/sheets_token.json
SHEET_ID=
SHEET_TAB_NAME=Applications

# State
STATE_DB_PATH=./data/state.db

# Behavior
LOOKBACK_HOURS=4
LOG_LEVEL=INFO
DRY_RUN=false
