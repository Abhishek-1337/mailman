<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS launchd job: run mailman every 3 hours, starting 15 minutes past the hour.
  Install:
    1. Edit the WorkingDirectory and EnvironmentVariables below to match your setup.
    2. Copy this file to ~/Library/LaunchAgents/com.user.mailman.plist
    3. launchctl load -w ~/Library/LaunchAgents/com.user.mailman.plist
  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.user.mailman.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.user.mailman</string>

  <key>ProgramArguments</key>
  <array>
    <string>/path/to/your/venv/bin/python</string>
    <string>-m</string>
    <string>src.main</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/abhishekvishwakarma/Ideas/mailman</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
  </dict>

  <!-- Run every 3 hours at :15 -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>0</integer><key>Minute</key><integer>15</integer></dict>
    <dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>15</integer></dict>
    <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>15</integer></dict>
    <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>15</integer></dict>
    <dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>15</integer></dict>
    <dict><key>Hour</key><integer>15</integer><key>Minute</key><integer>15</integer></dict>
    <dict><key>Hour</key><integer>18</integer><key>Minute</key><integer>15</integer></dict>
    <dict><key>Hour</key><integer>21</integer><key>Minute</key><integer>15</integer></dict>
  </array>

  <key>StandardOutPath</key>
  <string>/Users/abhishekvishwakarma/Ideas/mailman/logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/abhishekvishwakarma/Ideas/mailman/logs/launchd.err.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
